# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored (see .gitignore) — never commit real secrets.

# --- Supabase --------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
# NEXT_PUBLIC_* vars are bundled into client-side JS. That's fine for these
# two: the anon key is designed to be public and is constrained by Row Level
# Security (see supabase/migrations/*_rls.sql).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_. Bypasses
# Row Level Security entirely; only imported from src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Gemini (Aura AI) -------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# If unset, Aura AI features show an honest "temporarily unavailable" state —
# the rest of the app (dashboard, baseline, timeline, patterns) still works.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored (see .gitignore) — never commit real secrets.

# --- Supabase --------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
# No NEXT_PUBLIC_ prefix on any of these: this app has no browser-side
# Supabase client (every read/write goes through Server Components/Actions —
# see src/lib/env.ts for why), so nothing here needs to reach client-side JS.
# That also means it's safe to mark all three as "Sensitive" in a host like
# Vercel, if you want to.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Bypasses Row Level Security entirely; only
# imported from src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Gemini (Aura AI) -------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# If unset, Aura AI features show an honest "temporarily unavailable" state —
# the rest of the app (dashboard, baseline, timeline, patterns) still works.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
